/* =========================================================
   CATEGORY SECTION CONFIGURATION TOKENS
   Easily customize cards-per-view, gaps, and button sizes here
========================================================= */
:root {
    --cat-visible: 5;         /* Large screens (>= 1440px): 5 cards */
    --cat-gap: 18px;          /* Card gap */
    --cat-arrow-size: 44px;    /* 44px round arrow buttons */
}

@media (max-width: 1439px) {
    :root {
        --cat-visible: 4;     /* Laptop (1025px - 1439px): 4 cards */
        --cat-gap: 18px;
    }
}

@media (max-width: 1024px) {
    :root {
        --cat-visible: 3;     /* Tablet (768px - 1024px): 3 cards */
        --cat-gap: 16px;
    }
}

@media (max-width: 767px) {
    :root {
        --cat-visible: 2;     /* Phone (max 767px): 2 cards */
        --cat-gap: 14px;
    }
}

/* =========================================================
   MAIN SECTION CONTAINER
========================================================= */
.category-section {
    width: 100%;
    max-width: 1400px;
    margin: 60px auto 40px;
    padding: 0 24px;
    box-sizing: border-box;
    position: relative;
}

@media (max-width: 767px) {
    .category-section {
        margin: 40px auto 28px;
        padding: 0 16px;
    }
}

/* =========================================================
   HEADER (CONTRAST >= 4.5:1 GUARANTEED)
========================================================= */
.category-section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
}

.category-heading {
    max-width: 720px;
}

.category-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 8px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
    color: #22ff88; /* Bright green accent - High contrast */
    text-transform: uppercase;
}

.category-eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22ff88;
    box-shadow: 0 0 10px #22ff88;
    animation: catPulse 2s ease-in-out infinite;
}

@keyframes catPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.3); opacity: 0.7; }
}

.category-heading h2 {
    margin: 0 0 10px;
    font-size: clamp(28px, 4vw, 42px);
    line-height: 1.15;
    font-weight: 800;
    color: #ffffff; /* Solid fallback */
    background: linear-gradient(180deg, #ffffff 15%, #e2e8f0 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: -0.5px;
}

@supports not (-webkit-text-fill-color: transparent) {
    .category-heading h2 {
        color: #ffffff;
    }
}

.category-heading p {
    margin: 0;
    color: #d1d5db; /* Gray-300: 10.5:1 contrast against dark background */
    font-size: 16px;
    line-height: 1.6;
}

/* View All button */
.category-view-all {
    flex-shrink: 0;
    border: 1px solid rgba(34, 255, 136, 0.28);
    background: rgba(34, 255, 136, 0.08);
    color: #22ff88; /* Accent color */
    font-size: 14px;
    font-weight: 700;
    padding: 10px 18px;
    border-radius: 999px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.category-view-all span {
    font-size: 16px;
    transition: transform 0.25s ease;
}

.category-view-all:hover {
    background: #22ff88;
    color: #050505;
    border-color: #22ff88;
    box-shadow: 0 0 20px rgba(34, 255, 136, 0.35);
}

.category-view-all:hover span {
    transform: translateX(4px);
}

/* =========================================================
   SCROLLER CAROUSEL WRAPPER & CONTROLS
========================================================= */
.category-scroller-wrap {
    position: relative;
    width: 100%;
}

/* Round 44px Arrow Buttons */
.category-arrow-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: var(--cat-arrow-size, 44px);
    height: var(--cat-arrow-size, 44px);
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(14, 14, 16, 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 15;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
}

.category-arrow-btn.prev {
    left: 2px;
}

.category-arrow-btn.next {
    right: 2px;
}

.category-arrow-btn:hover:not(:disabled) {
    background: #22ff88;
    color: #030303;
    border-color: #22ff88;
    box-shadow: 0 0 24px rgba(34, 255, 136, 0.5);
    transform: translateY(-50%) scale(1.08);
}

.category-arrow-btn:disabled {
    opacity: 0.18;
    cursor: not-allowed;
    pointer-events: none;
}

@media (max-width: 767px) {
    .category-arrow-btn {
        display: none !important;
    }
}

/* Edge Fade Overlays */
.category-edge-fade-left,
.category-edge-fade-right {
    position: absolute;
    top: 0;
    bottom: 18px;
    width: 24px;
    pointer-events: none;
    z-index: 8;
    opacity: 0;
    transition: opacity 0.25s ease;
}

.category-edge-fade-left {
    left: 0;
    background: linear-gradient(90deg, #080808, transparent);
}

.category-edge-fade-right {
    right: 0;
    background: linear-gradient(-90deg, #080808, transparent);
}

.category-edge-fade-left.is-visible,
.category-edge-fade-right.is-visible {
    opacity: 1;
}

/* =========================================================
   HORIZONTAL SCROLLER (SINGLE ROW, SNAP, SINGLE PROGRESS BAR)
========================================================= */
.category-scroller {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    gap: var(--cat-gap);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    padding: 14px 44px 18px 44px;
    box-sizing: border-box;
    cursor: grab;
    user-select: none;
    outline: none;
    scrollbar-width: none !important; /* Hide native scrollbar Firefox */
    -ms-overflow-style: none !important; /* Hide native scrollbar IE/Edge */
}

.category-scroller::-webkit-scrollbar {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
}

.category-scroller.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
    scroll-snap-type: none;
}

.category-scroller:focus-visible {
    box-shadow: 0 0 0 2px #22ff88;
    border-radius: 16px;
}

/* On phones, hide native scrollbar and rely on touch swipe + progress bar */
@media (max-width: 767px) {
    .category-scroller::-webkit-scrollbar {
        display: none;
        height: 0;
    }
    .category-scroller {
        scrollbar-width: none;
        padding-bottom: 12px;
    }
}

/* =========================================================
   CARDS (PRESERVE PASTEL COLORS & STRUCTURE, EQUAL HEIGHT)
========================================================= */
.category-card {
    position: relative;
    box-sizing: border-box;
    flex: 0 0 calc((100% - (var(--cat-visible) - 1) * var(--cat-gap)) / var(--cat-visible));
    width: calc((100% - (var(--cat-visible) - 1) * var(--cat-gap)) / var(--cat-visible));
    min-width: calc((100% - (var(--cat-visible) - 1) * var(--cat-gap)) / var(--cat-visible));
    max-width: calc((100% - (var(--cat-visible) - 1) * var(--cat-gap)) / var(--cat-visible));
    height: 280px;

    padding: 22px 18px 18px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 22px;
    background: var(--category-bg);
    text-align: left;
    cursor: pointer;
    overflow: hidden;

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    scroll-snap-align: start;
    scroll-snap-stop: normal;

    animation: catFadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    transition:
        transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
        box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1),
        border-color 0.3s ease;
}

@keyframes catFadeUp {
    from {
        opacity: 0;
        transform: translateY(14px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@media (prefers-reduced-motion: reduce) {
    .category-card {
        animation: none !important;
        transition: none !important;
    }
}

/* Laptop-only hover lift of 6px and soft glow */
@media (hover: hover) and (pointer: fine) {
    .category-card:hover {
        transform: translateY(-6px);
        box-shadow:
            0 18px 40px rgba(0, 0, 0, 0.28),
            0 0 24px rgba(34, 255, 136, 0.15);
        border-color: rgba(34, 255, 136, 0.4);
    }

    .category-card:hover .category-arrow {
        transform: translateX(4px);
        background: #111827;
        color: #ffffff;
    }
}

.category-card.active {
    transform: translateY(-4px);
    border: 2px solid #111827;
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.16);
}

/* =========================================================
   CONSISTENT IMAGE / ICON AREA (UNIFORM CIRCLE)
========================================================= */
.category-image-wrapper {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    margin: 0 auto 12px auto;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
    flex-shrink: 0;
    transition: transform 0.35s ease;
}

.category-card:hover .category-image-wrapper {
    transform: scale(1.08);
}

.category-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.category-icon {
    font-size: 38px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* =========================================================
   CARD CONTENT & TYPOGRAPHY
========================================================= */
.category-content {
    position: relative;
    z-index: 2;
    flex-grow: 1;
}

.category-content h3 {
    margin: 0 0 4px 0;
    font-size: 18px;
    font-weight: 800;
    color: #111827; /* Dark contrast > 12:1 on pastel */
    line-height: 1.2;
}

.category-content p {
    margin: 0 0 10px 0;
    font-size: 13px;
    color: #4b5563; /* Gray-600 contrast > 7:1 on pastel */
    line-height: 1.45;
}

/* Meta row at bottom of card */
.category-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: auto;
}

.category-count-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px;
}

.category-count {
    font-size: 12px;
    font-weight: 700;
    color: #374151;
    background: rgba(0, 0, 0, 0.06);
    padding: 3px 9px;
    border-radius: 999px;
    display: inline-block;
}

/* Muted style for 0 products */
.category-count.is-empty {
    color: #6b7280;
    background: rgba(0, 0, 0, 0.04);
}

/* Coming soon pill */
.category-coming-soon {
    font-size: 11px;
    font-weight: 700;
    color: #4b5563;
    background: rgba(107, 114, 128, 0.12);
    border: 1px solid rgba(107, 114, 128, 0.22);
    padding: 2px 7px;
    border-radius: 999px;
    display: inline-block;
}

/* Arrow button inside card */
.category-arrow {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.05);
    color: #111827;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 700;
    transition: all 0.25s ease;
    flex-shrink: 0;
}

/* =========================================================
   SCROLL PROGRESS BAR
========================================================= */
.category-progress-track {
    width: 100%;
    max-width: 280px;
    height: 4px;
    margin: 8px auto 0;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    overflow: hidden;
    position: relative;
}

.category-progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #22ff88, #38bdf8);
    border-radius: 999px;
    transition: width 0.15s ease-out;
}

/* =========================================================
   ACTIVE CATEGORY PILL
========================================================= */
.category-active-message {
    margin-top: 20px;
    padding: 10px 18px;
    border-radius: 12px;
    background: rgba(34, 255, 136, 0.08);
    border: 1px solid rgba(34, 255, 136, 0.25);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: #ffffff;
}

.category-active-message strong {
    color: #22ff88;
}

.category-active-message button {
    border: none;
    background: transparent;
    color: #ffffff;
    opacity: 0.7;
    cursor: pointer;
    font-size: 16px;
    transition: opacity 0.2s ease;
}

.category-active-message button:hover {
    opacity: 1;
}