# =============================================================================
# KSAM DEAL - CLIENT ENVIRONMENT CONFIGURATION
# =============================================================================
# Vite exposes variables prefixed with VITE_ to the browser.
# DO NOT put your SUPABASE_SERVICE_ROLE_KEY here or expose it to client code!
# =============================================================================

# Your Supabase Project URL (Supabase Dashboard > Project Settings > API)
# Must start with https:// and have NO trailing slash.
# Example for project ref kavvzolevucqleoewlnf:
VITE_SUPABASE_URL=https://kavvzolevucqleoewlnf.supabase.co

# Your Supabase Anonymous Public Key (Supabase Dashboard > Project Settings > API > Project API keys)
# Look for the 'anon' 'public' key (typically starts with eyJ...) or your project's publishable key.
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
