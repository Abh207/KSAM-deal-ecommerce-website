# =============================================================================
# KSAM DEAL - CLIENT ENVIRONMENT CONFIGURATION
# =============================================================================
# Vite exposes variables prefixed with VITE_ to the browser.
# NEVER put your SUPABASE_SERVICE_ROLE_KEY here or expose it to client code!
# =============================================================================

# Your Supabase Project URL (found in Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anonymous Public Key (safe to use in browser)
VITE_SUPABASE_ANON_KEY=your-anon-key-here
